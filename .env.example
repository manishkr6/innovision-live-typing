# ==========================================
# INNOVISION 2026 — Environment Variables
# ==========================================

# --- FIREBASE CONFIGURATION ---
# Found in: Firebase Console -> Project Settings -> General -> Web App SDK Setup
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID=""

# Firestore Database ID: Set to "(default)" for standard Firebase projects
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# --- ORGANIZER / ADMIN ACCESS ---
# Whitelisted Google account email for the organizer dashboard
VITE_ADMIN_EMAIL="organizer@example.com"

# --- OPTIONAL / AI STUDIO APPLET CONFIG ---
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
